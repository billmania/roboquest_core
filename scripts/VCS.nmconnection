#
# Verified on debian trixie.
#
[connection]
id=VCS
#
# Use the uuidgen utility from the uuid-runtime debian package.
#
uuid=<UUID>
type=wifi
autoconnect=true
#
# Use "date +%s"
#
timestamp=<TIMESTAMP>

[wifi]
mode=infrastructure
ssid=VCS

[wifi-security]
key-mgmt=wpa-eap

[802-1x]
eap=peap;
#
# Add the IDENTITY and PASSWORD without surrounding quotation
# marks or apostrophes.
#
identity=<IDENTITY>
password=<PASSWORD>
phase2-auth=mschapv2

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=auto

[proxy]
